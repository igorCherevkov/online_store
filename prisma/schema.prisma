// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  created
  paid
  payment_failed
  completed
}

enum OrderItemStatus {
  pending
  delivering
  delivered
  out_of_stock
  delivery_failed
  refunded
}

enum PaymentStatus {
  paid
  failed
}

enum MoneyRecordType {
  charge 
  refund
}

enum QueueStatus {
  queued
  processing
  completed
  failed
}

enum EntityType {
  order
  order_item
}

model Product {
  sku String @id
  name String
  price Int
  currency String
  type String
  image    String
  availableCount Int @default(0)

  orderItems OrderItem[]
  gameKeys GameKey[]

  @@index([availableCount])
}

model Order {
  id String @id @default(cuid())
  status OrderStatus @default(created)
  totalAmount Int
  currency String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  payments Payment[]
  items OrderItem[]
  moneyRecord MoneyRecord[]

  @@index([status])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  sku String
  product Product @relation(fields: [sku], references: [sku])
  amount Int
  currency String
  status OrderItemStatus @default(pending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameKey GameKey?
  deliveryAttempts DeliveryAttempt[]
  moneyRecords MoneyRecord[]
  queueEntry DeliveryQueue?

  @@index([orderId])
  @@index([status])
}

model Payment {
  id String @id @default(cuid())
  eventId String @unique
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  status PaymentStatus
  payload Json
  processedAt DateTime @default(now())

  @@index([orderId])
}

model GameKey {
  id String @id @default(cuid())
  sku String
  product Product @relation(fields: [sku], references: [sku])
  code String @unique
  orderItemId String? @unique
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  reservedAt DateTime?

  @@index([sku, orderItemId])
}

model DeliveryAttempt {
  id String @id @default(cuid())
  requestId String
  attemptNumber Int
  orderItemId String
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  provider String
  status String
  code String?
  createdAt DateTime @default(now())

  @@unique([requestId, attemptNumber])
  @@index([orderItemId])
}

model MoneyRecord {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  orderItemId String?
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  type MoneyRecordType
  amount Int
  currency String
  createdAt DateTime @default(now())

  @@unique([orderItemId, type])
  @@index([orderId])
}

model DeliveryQueue {
  id String @id @default(cuid())
  orderItemId String @unique
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  sku String
  priority Int @default(0)
  status QueueStatus @default(queued)
  createdAt DateTime @default(now())
  startedAt DateTime? 
  completedAt DateTime?
  
  @@index([status, priority, createdAt])
}

model StatusEvent {
  id String @id @default(cuid())
  entityType EntityType
  entityId String
  oldStatus String?
  newStatus String
  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
